<Window x:Class="EqSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ Sync" Height="620" Width="980" MinHeight="520" MinWidth="840"
        Closing="OnClosing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshButton" Content="Refresh" Width="92" Margin="8,0,0,0" Click="OnRefreshClicked" />
                <Button x:Name="OpenLogButton" Content="Open Log" Width="92" Margin="8,0,0,0" Click="OnOpenLogClicked" />
                <Button x:Name="UpdateButton" Content="Check Updates" Width="116" Margin="8,0,0,0" Click="OnCheckUpdatesClicked" />
                <Button x:Name="PreviewButton" Content="Preview Sync" Width="112" Margin="8,0,0,0" Click="OnPreviewClicked" />
                <Button x:Name="ApplyButton" Content="Apply Sync" Width="104" Margin="8,0,0,0" Click="OnApplyClicked" IsEnabled="False" />
            </StackPanel>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="EQ Sync" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="#555"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="56" />
                <ProgressBar x:Name="BusyProgress"
                             Height="6"
                             Margin="0,8,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.7*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Installs" Grid.Column="0" Margin="0,0,12,0">
                <ListBox x:Name="InstallsList" DisplayMemberPath="DisplayName" />
            </GroupBox>

            <GroupBox Header="LAN Peers" Grid.Column="1" Margin="0,0,12,0">
                <ListBox x:Name="PeersList" DisplayMemberPath="MachineName" />
            </GroupBox>

            <GroupBox Header="Preview" Grid.Column="2">
                <DataGrid x:Name="PreviewGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Action}" Header="Action" Width="130" />
                        <DataGridTextColumn Binding="{Binding RelativePath}" Header="File" Width="*" />
                        <DataGridTextColumn Binding="{Binding Reason}" Header="Reason" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1,0,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#555">
                Select the same install type and a LAN peer, preview the plan, then apply. If preview looks wrong, click Open Log and send the log file.
            </TextBlock>
        </Border>
    </Grid>
</Window>
